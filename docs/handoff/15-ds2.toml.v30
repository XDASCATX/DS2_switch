# DS2 Switch - base configuration v30 (2026-10-20), diag14 NRO and later.
# Proven on the console: level loads, correct colours, ~3-5 FPS in the world (was ~1.4 FPS, red tint).
# Each line below is explained in docs/handoff/11-switch-level-load-diag.md and 13-switch-diag-modes.md.
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = false
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_head;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
# Smaller host texture cache (heap headroom on the console).
texture_cache_memory_limit_soft = 128
texture_cache_memory_limit_hard = 256
texture_cache_memory_limit_soft_lifetime = 5
ds2_watchdog_probe_tables = 0
# Guest memory in 2 MB pieces (fewer kernel page tables); 6 MB host stacks are the Switch default.
ds2_switch_commit_granule_kb = 2048
# Every occlusion query used to stop the GPU; little effect on FPS, kept off for now.
occlusion_query_enable = false
# MODE 7 as a permanent setting: depth transfers copy depth but skip the 8 stencil-bit passes
# (NVK has no shader stencil export). Removes the red tint and most of the GPU cost.
render_target_transfer_skip = 1
# 0 = no diagnostic mode; L+R+ZL still runs the A/B lap on top of this configuration.
edram_diagnostic_mode = 0
