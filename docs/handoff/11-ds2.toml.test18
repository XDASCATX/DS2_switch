# Test 18 - diag10 (same NRO as test 17), test 17 settings plus the GPU driver counters (NVK_SWITCH_PERF_LOG=1). Also: a much smaller host texture cache (the SDK allows 384 MB soft /
# 768 MB hard by default). The level load allocated ~250-570 MB in 2 s right before every failure.
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = false
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_head;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
texture_cache_memory_limit_soft = 128
texture_cache_memory_limit_hard = 256
texture_cache_memory_limit_soft_lifetime = 5
ds2_watchdog_probe_pages = 512
