# Test 23 - diag12 NRO, stock hbloader. Test 21 settings plus host occlusion queries off. In test 22 the GPU
# thread waited for GPU fences ~985 ms of every second (199 waits/s at 1.4 FPS, ~140 per frame): every guest
# occlusion query end submits and waits for the whole GPU (VulkanCommandProcessor::EndGuestOcclusionQuery), and the
# game's main thread spins (sub_829E9E28) until the GPU catches up. Off = fake count 1000 (all visible).
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = false
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_head;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
texture_cache_memory_limit_soft = 128
texture_cache_memory_limit_hard = 256
texture_cache_memory_limit_soft_lifetime = 5
ds2_watchdog_probe_tables = 0
ds2_switch_commit_granule_kb = 2048
host_thread_stack_mb = 6
occlusion_query_enable = false
