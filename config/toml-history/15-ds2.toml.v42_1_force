# DS2 Switch - v42 test 1 (force). Base = v41 (ds2.toml), call counters off, plus ds2_editor_wait_log = true:
# every 2 s the log gets "[editor]" lines with the "is the UI free" check (sub_8239A2E8) that the event script
# polls every frame on the black screen, the other two per-frame script conditions and the menu-flow state.
# Found from the v41 counts (diag_toml41A): after the cutscene the game fades to black and never fades back in;
# no editor code runs; the only new per-frame code is that check (docs/handoff/16-switch-gpu-optimization.md).
# HYPOTHESIS 1: the script waits for "UI free" (ui[116][16] == 0) and it never becomes free.
# CHANGE: ds2_editor_force_free_s = 5 - after 5 s of continuous "busy" the check answers "free".
# EXPECTED: if the check is the blocker, ~5 s after the black screen the editor fades in (or the game moves on);
# the log shows "[editor] ... FORZADO". If the log says "UI libre", the check is not the blocker (then test 2).
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = false
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_v33;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
# Smaller host texture cache (heap headroom on the console).
texture_cache_memory_limit_soft = 128
texture_cache_memory_limit_hard = 256
texture_cache_memory_limit_soft_lifetime = 5
ds2_watchdog_probe_tables = 0
# Guest memory in 2 MB pieces (fewer kernel page tables); 6 MB host stacks are the Switch default.
ds2_switch_commit_granule_kb = 2048
# MODE 7 as a permanent setting: depth transfers skip the 8 stencil-bit passes (NVK has no stencil export).
render_target_transfer_skip = 1
edram_diagnostic_mode = 0
# v32: clears and other unclipped screen rectangles: height from their vertices instead of "to the end of EDRAM".
execute_unclipped_draw_vs_on_cpu = true
# v32: do not transfer old EDRAM contents into areas the draw then overwrites completely (same image, less GPU work).
render_target_transfer_elide_overwritten = true
# v33: the same for depth-only draws (shadow maps, depth clears) and clipped full-screen passes.
render_target_transfer_elide_extended = true
# v33: one-pass resolves (same bytes in game memory as before - checked byte by byte on PC).
render_target_direct_resolve = true
# GPU time per kind of work in rex_perfil.log (v38C: switching it off changed nothing visible).
gpu_zone_timing = true
gpu_zone_timing_fine = false
gpu_zone_timing_fine_every = 0
# v35: at most 2 frames queued for the GPU.
vulkan_max_frames_in_flight = 2
# Statistics (log lines every few seconds, no effect on the image).
vulkan_barrier_stats = 600
vulkan_memory_report_frames = 300
rt_transfer_stats = 4000
rt_transfer_stats_reset = true
ds2_switch_stack_sampling = true
# v36: uploads at the start of the frame.
vulkan_shared_memory_hoist_uploads = true
# CPU copies of small resolves (v36).
readback_resolve = "fast"
readback_resolve_max_bytes = 65536
# v39-v41 diagnostic
audio_xma_estado = false
ds2_func_counts = false
ds2_func_counts_every_s = 10
ds2_editor_wait_log = true
ds2_editor_force_free_s = 5
ds2_msr_per_thread = false
ds2_fpcr_ftz_fixed = false
ds2_export_stats = true
resolve_dump_dir = ""
resolve_dump_start_s = 300
resolve_dump_every_s = 30
resolve_dump_max = 6
resolve_dump_max_mb = 64
