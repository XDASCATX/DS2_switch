# Test 21 - diag12 NRO (same as test 20), stock hbloader. Test 20 passed the old 2001-0103 point but ran out of heap
# (memalign in NVK failed, malloc arena 3079 of ~3185 MB). 741 MB of it were host stacks of guest threads
# (44 x 16 MB) that use at most ~3.6 MB each (PC measurement): 6 MB each frees ~440 MB.
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = false
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_head;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
texture_cache_memory_limit_soft = 128
texture_cache_memory_limit_hard = 256
texture_cache_memory_limit_soft_lifetime = 5
ds2_watchdog_probe_tables = 0
ds2_switch_commit_granule_kb = 2048
host_thread_stack_mb = 6
