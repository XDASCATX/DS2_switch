# Tests 19/20 - diag12. Test 18 settings. New in the build (on by default, listed for clarity):
#   guest memory committed in 2 MB-aligned pieces with a 2 MB-aligned window and code alias
#   (ds2_switch_commit_granule_kb = 2048; 4 = the old exact commits), and the page-table probe
#   (pt_left / pt_win / chunks in the heartbeat). Test 19: hbl_ds2.nsp (own 64 MB system resource);
#   test 20: the same file with the stock hbl.nsp.
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = false
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_head;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
texture_cache_memory_limit_soft = 128
texture_cache_memory_limit_hard = 256
texture_cache_memory_limit_soft_lifetime = 5
ds2_watchdog_probe_tables = 32
ds2_switch_commit_granule_kb = 2048
