# DS2 Switch - v55. The only test file: native renderer (no Xenos emulation).
# v55: early depth test in pixel shaders, no full GPU barrier between render passes, pipelines compiled on a worker
# thread (no picture freezes when new effects appear), occlusion queries back to "always visible" (v54's real ones
# made enemies blink), session clocks set by the game, correct GPU timer on the console, hitch log, L3+R3 capture.
# See docs/handoff/18-native-renderer.md.
log_level = "info"
ds2_watchdog = true
ds2_switch_saltynx = true
ds2_mesa_env = "MESA_SHADER_CACHE_DIR=sdmc:/switch/ds2/mesa_cache_v33;NOUVEAU_HORIZON_BO_CACHE_MB=16;NVK_SWITCH_PERF_LOG=1"
nfsmw_io_rangos_mb = 0
ds2_switch_nvmap_mb = 64
ds2_watchdog_probe_tables = 0
# Guest memory in 2 MB pieces (fewer kernel page tables).
ds2_switch_commit_granule_kb = 2048
# Thread stack samples in rex_perfil.log.
ds2_switch_stack_sampling = true
audio_xma_estado = false
ds2_func_counts = false
ds2_func_counts_every_s = 10
ds2_editor_wait_log = false
ds2_editor_force_free_s = 0
ds2_editor_open_mode = 0
ds2_editor_open_after_s = 8
ds2_msr_per_thread = false
ds2_fpcr_ftz_fixed = false
ds2_export_stats = true

# --- clocks for the session (Horizon OC / sys-clk override; released when the game exits; 0 = not touched) ---
ds2_switch_cpu_mhz = 1963
ds2_switch_gpu_mhz = 1267
ds2_switch_mem_mhz = 0

# --- native renderer ---
ds2_native_renderer = true
ds2_native_log_every = 300
# GPU time per pass kind ("[native gpu]" lines) and command processor CPU time ("[native] cpu ms per frame").
ds2_native_gpu_profile = true
# A frame longer than this many ms is explained in the log ("[native] hitch").
ds2_native_hitch_ms = 100
ds2_native_mips = true
ds2_native_max_anisotropy = 0
ds2_native_early_z = true
ds2_native_async_pipelines = true
# true = full barrier before every render pass, as v51-v54 (only to check a rendering error).
ds2_native_pass_barriers = false
# true = real occlusion queries (v54: enemies blinked); false = always visible.
ds2_native_occlusion_queries = false
# Hold L3 + R3 (both sticks pressed) ~1 s: the next frame is traced into the log and its images are written to
# sdmc:/switch/ds2/native_dump/capture_NN (a few seconds of freeze, ~50 MB).
ds2_native_capture_combo = true
