From 3d5b408944e484b602af0571bfdee750e8c56deb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:06:18 +0300
Subject: [PATCH 1/3] DS2 Switch: NAK texture/memory latency 200,
 peephole_select limit 8, bump compiler revision

---
 src/nouveau/compiler/nak/opt_instr_sched_common.rs | 7 +++++--
 src/nouveau/compiler/nak_nir.c                     | 4 +++-
 src/nouveau/vulkan/nvk_shader.c                    | 2 +-
 3 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/src/nouveau/compiler/nak/opt_instr_sched_common.rs b/src/nouveau/compiler/nak/opt_instr_sched_common.rs
index 2d8be486f6d..186e5afbe94 100644
--- a/src/nouveau/compiler/nak/opt_instr_sched_common.rs
+++ b/src/nouveau/compiler/nak/opt_instr_sched_common.rs
@@ -289,7 +289,9 @@ pub fn estimate_variable_latency(sm: &ShaderModelInfo, op: &Op) -> u32 {
         | Op::Tld4(_)
         | Op::Tmml(_)
         | Op::Txd(_)
-        | Op::Txq(_) => 32,
+        // DS2 Switch port (as nfsmw-nx): on GM20B + shared LPDDR4 a texture miss costs hundreds of cycles.
+        // Only the scheduler's priority changes; scoreboard waits are computed separately.
+        | Op::Txq(_) => 200,
 
         // Surface ops
         Op::SuLd(_)
@@ -314,7 +316,8 @@ pub fn estimate_variable_latency(sm: &ShaderModelInfo, op: &Op) -> u32 {
         | Op::Ipa(_)
         | Op::CCtl(_)
         | Op::LdTram(_)
-        | Op::MemBar(_) => 32,
+        // DS2 Switch port: global memory loads from shared LPDDR4 do not take 32 cycles either.
+        | Op::MemBar(_) => 200,
 
         // Control-flow ops
         Op::WarpSync(_) => 16,
diff --git a/src/nouveau/compiler/nak_nir.c b/src/nouveau/compiler/nak_nir.c
index beb01b1d9db..3f0c26546ef 100644
--- a/src/nouveau/compiler/nak_nir.c
+++ b/src/nouveau/compiler/nak_nir.c
@@ -203,8 +203,10 @@ nak_optimize_nir(nir_shader *nir, const struct nak_compiler *nak)
       LOOP_OPT(nir, nir_opt_dce);
       LOOP_OPT(nir, nir_opt_cse);
 
+      /* DS2 Switch port (as nfsmw-nx): NAK has no if-to-predicate pass, so every surviving if is a real
+       * branch (SSY/BRA/SYNC) on Maxwell; ANV and RADV flatten up to 8 instructions. */
       nir_opt_peephole_select_options peephole_select_options = {
-         .limit = 0,
+         .limit = 8,
          .discard_ok = true,
       };
       LOOP_OPT_NOT_IDEMPOTENT(nir, nir_opt_peephole_select,
diff --git a/src/nouveau/vulkan/nvk_shader.c b/src/nouveau/vulkan/nvk_shader.c
index e63104958c0..6ba5a40f0c5 100644
--- a/src/nouveau/vulkan/nvk_shader.c
+++ b/src/nouveau/vulkan/nvk_shader.c
@@ -82,7 +82,7 @@ nvk_physical_device_compiler_flags(const struct nvk_physical_device *pdev)
    return (no_cbufs ? 1 << 12 : 0)
       | (use_edb_buffer_views ? 1 << 13 : 0)
       | (instance->drirc.misc.ssbo_align_4b ? 1 << 14 : 0)
-      | (UINT64_C(10) << 16) /* Compiler ABI revision. */
+      | (UINT64_C(11) << 16) /* Compiler ABI revision (DS2 port: 11 = NAK latency/peephole changes). */
       | (nak_flags << 48);
 }
 
-- 
