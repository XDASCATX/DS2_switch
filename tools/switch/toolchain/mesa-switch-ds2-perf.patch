From 7eae6df319738b6f8cf196078f26ad6571d6b255 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 20:58:29 +0300
Subject: [PATCH 3/3] DS2 Switch: bind set UBO descriptors from the CPU mapping
 on Maxwell (no indirect GPFIFO segments)

NVK_SWITCH_CBUF_DESC_INDIRECT=1 restores the indirect path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LXFoLk8fEvKbvg3kaZBmo7
---
 src/nouveau/vulkan/nvk_cmd_buffer.c | 31 +++++++++++++++++++++++++++++
 src/nouveau/vulkan/nvk_device.c     |  2 ++
 src/nouveau/vulkan/nvk_device.h     |  5 +++++
 3 files changed, 38 insertions(+)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index 60ae745ace7..933957792d4 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -1768,6 +1768,37 @@ nvk_cmd_buffer_get_cbuf_addr(struct nvk_cmd_buffer *cmd,
    }
 
    case NVK_CBUF_TYPE_UBO_DESC: {
+#ifdef HAVE_SWITCH_PLATFORM
+      /* DS2 Switch: on Maxwell (no MME memory reads) a UBO descriptor that
+       * lives in a regular descriptor set is otherwise bound by pushing its
+       * 12 bytes as an indirect GPFIFO segment.  That costs two GPFIFO
+       * entries per binding, a no-prefetch (sync) entry, and the pending
+       * MME-data semaphore drain after every barrier.  Xenia rebinds ~5
+       * UBOs per stage on almost every draw, so a frame needed ~10k GPFIFO
+       * entries and NVK had to split it into several kickoffs that each
+       * waited for the previous one to retire.
+       *
+       * Without UPDATE_AFTER_BIND the set contents cannot legally change
+       * between binding and execution, and descriptor memory is written by
+       * the CPU only, so reading the descriptor from the CPU mapping at
+       * record time gives the same value the GPU would fetch.
+       */
+      if (desc->sets[cbuf->desc_set].type == NVK_DESCRIPTOR_SET_TYPE_SET &&
+          nvk_cmd_buffer_device(cmd)->switch_cbuf_desc_cpu) {
+         const struct nvk_descriptor_set *set = desc->sets[cbuf->desc_set].set;
+         if (set != NULL && set->map != NULL &&
+             !(set->layout->flags &
+               VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT) &&
+             cbuf->desc_offset + sizeof(union nvk_buffer_descriptor) <=
+                set->size_B) {
+            union nvk_buffer_descriptor set_desc;
+            memcpy(&set_desc, (const char *)set->map + cbuf->desc_offset,
+                   sizeof(set_desc));
+            *addr_out = nvk_ubo_descriptor_addr(pdev, set_desc);
+            return true;
+         }
+      }
+#endif
       if (desc->sets[cbuf->desc_set].type != NVK_DESCRIPTOR_SET_TYPE_PUSH)
          return false;
 
diff --git a/src/nouveau/vulkan/nvk_device.c b/src/nouveau/vulkan/nvk_device.c
index 2dcd1f2791c..b687c1aa0c5 100644
--- a/src/nouveau/vulkan/nvk_device.c
+++ b/src/nouveau/vulkan/nvk_device.c
@@ -337,6 +337,8 @@ nvk_CreateDevice(VkPhysicalDevice physicalDevice,
 
 #ifdef HAVE_SWITCH_PLATFORM
    dev->ubo_delta_enabled = true;
+   dev->switch_cbuf_desc_cpu =
+      !debug_get_bool_option("NVK_SWITCH_CBUF_DESC_INDIRECT", false);
 #endif
 
    dev->vk.shader_ops = &nvk_device_shader_ops;
diff --git a/src/nouveau/vulkan/nvk_device.h b/src/nouveau/vulkan/nvk_device.h
index 1e3e616ef20..37fbfb23d52 100644
--- a/src/nouveau/vulkan/nvk_device.h
+++ b/src/nouveau/vulkan/nvk_device.h
@@ -54,6 +54,11 @@ struct nvk_device {
     */
    bool cpu_write_mem_uncached;
    bool ubo_delta_enabled;
+   /* Horizon: bind set UBO descriptors from the CPU mapping (see
+    * nvk_cmd_buffer_get_cbuf_addr).  NVK_SWITCH_CBUF_DESC_INDIRECT=1 restores
+    * the indirect GPFIFO path for A/B comparisons.
+    */
+   bool switch_cbuf_desc_cpu;
 
    struct nvk_upload_queue upload;
 
-- 
